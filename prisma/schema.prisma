datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String     @id @default(uuid())
  name               String     @default("Sharma Household")
  language           String     @default("hi")
  role               String     @default("household") // "household" or "vendor"
  householdCode      String     @default("SHARMA-402")
  activeMemberName   String     @default("Kaushal")
  vendorBusinessName String?    @default("Raju Doodh Dairy")
  vendorCategory     String?    @default("milk") // milk, water, laundry, tiffin
  vendorRouteName    String?    @default("Gokuldham Heights - Tower A")
  createdAt          DateTime   @default(now())
  vendors            Vendor[]
  entries            Entry[]
  customers          Customer[]
}

model Vendor {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category          String   // milk, water, laundry, maid, tiffin, newspaper, custom
  displayName       String   // e.g. Doodh Wala, Paani Wala
  unit              String   // litres, cans, pieces, day, meals, copies
  unitRate          Float    @default(0) // ₹ per unit
  jarDepositBalance Int      @default(0) // empty jars tally for water
  vendorPhone       String?
  icon              String?  @default("🥛")
  color             String?  @default("#3B82F6")
  createdAt         DateTime @default(now())
  entries           Entry[]
}

// For Vendor Mode: Customer list (e.g. Flat 402, Flat 501)
model Customer {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  flatNumber      String             // e.g. "Flat 402", "B-104"
  customerName    String             // e.g. "Sharma Ji", "Verma Ji"
  phone           String?
  dailyQuantity   Float              @default(1.0)
  pendingBalance  Float              @default(0)
  createdAt       DateTime           @default(now())
  deliveries      CustomerDelivery[]
}

model CustomerDelivery {
  id           String   @id @default(uuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deliveryDate String   // YYYY-MM-DD
  quantity     Float    @default(0)
  unit         String   @default("litres")
  action       String   @default("received") // received, absent, extra
  amount       Float    @default(0)
  notes        String?
  createdAt    DateTime @default(now())
}

model Entry {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorId         String
  vendor           Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  entryDate        String   // YYYY-MM-DD
  quantity         Float
  unit             String
  action           String   // received, given, absent, advance, returned, skipped
  metadata         String?  // JSON stringified for items, notes, emptyReturned
  amountCalculated Float    @default(0)
  rawTranscript    String?
  loggedBy         String?  @default("Self") // "Mummy", "Kaushal", "Papa"
  customerFlat     String?  // If logged in vendor mode
  createdAt        DateTime @default(now())
}
